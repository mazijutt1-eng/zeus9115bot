# Get your bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID; multiple admins separated by commas
ADMIN_IDS=

# Add only the API keys for providers you want to enable
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-latest

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Optional
OPENAI_BASE_URL=
DEFAULT_MODEL=chatgpt
FREE_DAILY_LIMIT=20
PREMIUM_DAILY_LIMIT=300
DATABASE_PATH=zeus_ai.db
